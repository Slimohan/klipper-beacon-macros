# Example pieces for printer.cfg. Adapt the values to your printer.
# Only the parts that matter for the Beacon macro set are shown.

[include beacon_macros/beacon_macros.cfg]
# Optional extras (scan compensation, adaptive heat soak, multi-point true zero).
# Run install.sh first and restart Klipper, otherwise leave this line commented.
#[include beacon_macros/beacon_extras.cfg]
# Optional: RatOS style START_PRINT / END_PRINT (the slicer calls START_PRINT, see README.md).
# It needs [virtual_sdcard] and [pause_resume]. With it you do not need the PRINT_START below.
#[include beacon_macros/beacon_print.cfg]
# Optional: CANCEL_PRINT that runs END_PRINT. Do NOT use it together with mainsail.cfg or
# fluidd.cfg: they already rename CANCEL_PRINT and Klipper would refuse to start. With those,
# use the _CLIENT_VARIABLE block further down instead.
#[include beacon_macros/beacon_cancel_print.cfg]

# Settings you want to change. List only what differs from beacon_settings.cfg.
[gcode_macro _BEACON_SETTINGS]
variable_beacon_contact_true_zero_temp: 170
variable_z_hop: 15
# extras, see README.md
#variable_beacon_adaptive_heat_soak: True
#variable_beacon_scan_compensation_enable: True

# Remove [safe_z_home] and any old [probe] section from your config: the Beacon replaces both.

[beacon]
# copy the path from: ls /dev/serial/by-id/
serial: /dev/serial/by-id/usb-Beacon_Beacon_RevH_xxxxxxxx-if00
# nozzle to Beacon coil centre: +y = Beacon behind the nozzle, +x = to the right
x_offset: 0
y_offset: 20
mesh_main_direction: x
mesh_runs: 2
# Must be at least 10 degrees above the highest temperature used by the macros
# (variable_beacon_contact_expansion_cal_temp_high, default 250). The hotend briefly
# overshoots its target, and an equal value stops the calibration with a temperature error.
contact_max_hotend_temperature: 260
# home_method: contact is optional, see variable_beacon_contact_z_homing.
# Z homing position, the same point as safe_home_x/y and zero_reference_position.
home_xy_position: 150, 150
home_z_hop: 5

[stepper_z]
# Only these lines change. Comment out position_endstop and the old endstop_pin
# wherever they are, also in printer.cfg after an include of this file.
endstop_pin: probe:z_virtual_endstop
homing_retract_dist: 0

[save_variables]
filename: ~/printer_data/config/variables.cfg

# Orca adds EXCLUDE_OBJECT_DEFINE lines to the G-code; this lets Klipper use them.
[exclude_object]

[bed_mesh]
speed: 300
horizontal_move_z: 2
mesh_min: 20, 30
mesh_max: 280, 280
probe_count: 20, 20
# Zero reference: pick ONE of the two ways, see "Zero reference and fuzzy true zero" in README.md.
# A) fixed reference at the safe home position, with the fuzzy true zero switched off
#    (variable_beacon_contact_start_print_true_zero_fuzzy_position: False):
zero_reference_position: 150, 150
# B) with the extras installed: leave zero_reference_position out. START_PRINT then
#    references every mesh to the spot where the true zero was measured.

# With mainsail.cfg or fluidd.cfg (instead of beacon_cancel_print.cfg): their CANCEL_PRINT
# runs END_PRINT, and END_PRINT does the parking.
#[gcode_macro _CLIENT_VARIABLE]
#variable_park_at_cancel: False
#variable_user_cancel_macro: "END_PRINT"
#gcode:

# Optional, Z homing through the macro set
#[homing_override]
#axes: z
#set_position_z: 0
#gcode:
#    {% if 'xy' not in printer.toolhead.homed_axes %}
#        G28 X Y
#    {% endif %}
#    BEACON_HOME_Z

[gcode_macro PRINT_START]
gcode:
    {% set BED = params.BED|default(60)|float %}
    {% set EXTRUDER = params.EXTRUDER|default(210)|float %}
    G28
    M190 S{BED}
    # adaptive heat soak when the extras are installed and enabled, otherwise bed_heat_soak_time
    {% if printer["gcode_macro BEACON_HEAT_SOAK"] is defined %}BEACON_HEAT_SOAK{% endif %}
    # level after the soak: the gantry moves while it warms up
    {% if printer.z_tilt is defined %}Z_TILT_ADJUST{% endif %}
    {% if printer.quad_gantry_level is defined %}QUAD_GANTRY_LEVEL{% endif %}
    G28 Z
    # contact true zero at the configured temperature, then switch to print temperature
    BEACON_TRUE_ZERO
    {% if printer["gcode_macro BEACON_PREFLIGHT_SCAN_COMPENSATION"] is defined %}BEACON_PREFLIGHT_SCAN_COMPENSATION BED_TEMP={BED}{% endif %}
    BEACON_BED_MESH PROFILE=default
    M109 S{EXTRUDER}

[gcode_macro PRINT_END]
gcode:
    M104 S0
    M140 S0
    BEACON_RESET_NOZZLE_TEMP_OFFSET
